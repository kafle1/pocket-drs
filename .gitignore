.DS_Store
**/.DS_Store

# Logs
*.log
logs/
logs/**

# Local environment (do not commit secrets / machine-specific config)
.env
.env.*

# IDE
.vscode/
.idea/

# Flutter/Dart (repo-level; Flutter app has its own .gitignore too)
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.packages
**/build/
!server/app/static/three/build/

# Python
**/__pycache__/
**/*.py[cod]
.pytest_cache/

# Virtualenvs
**/.venv/
**/venv/

# Runtime job outputs
data/jobs/
**/output/
**/temp/

# Validation harness artefacts (regeneratable from server/scripts/)
dump/validation/

# Test videos
*.mp4
*.avi
*.mov
!docs/media/*.mp4

# Generated documentation
site/


# Third-party test clips (downloaded, not for distribution)
dump/internet_tests/

# paper build artefacts and rendered evaluation clips (regenerated by paper/experiments)
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/*.synctex.gz
paper/experiments/clips/
paper/experiments/__pycache__/

# downloaded third-party clips used for real-video checks
bench/
