<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="theme-color" content="#0c110f" />
<title>Pocket DRS ball tracking</title>
<style>
  /* hex, not oklch: iOS 15 Safari has no oklch. Same palette as the app, oklch in the comments */
  :root {
    --bg: #0c110f;          /* oklch(0.17 0.008 155) */
    --panel: #121815;       /* oklch(0.20 0.010 155) */
    --raise: #1b231f;       /* oklch(0.24 0.012 155) */
    --line: #26302b;        /* oklch(0.29 0.012 155) */
    --ink: #f7f9f7;         /* oklch(0.98 0.004 150) */
    --muted: #9aa59f;       /* oklch(0.71 0.015 155) */
    --accent: #007e46;      /* oklch(0.52 0.13 155) */
    --out: #c9302d;         /* oklch(0.55 0.19 27) */
    --not-out: #1c8742;     /* oklch(0.55 0.14 150) */
    --call: #d0901e;        /* oklch(0.70 0.14 75) */
    --call-ink: #23190a;    /* oklch(0.22 0.03 75) */
    --ease: cubic-bezier(.22, 1, .36, 1);
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; height: 100%; background: var(--bg); color: var(--ink);
    font: 14px/1.4 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, system-ui, sans-serif;
    -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: transparent; overflow: hidden; }
  button { font: inherit; color: inherit; border: 0; cursor: pointer; }

  #app { position: fixed; inset: 0; display: flex; flex-direction: column; }
  #stage { position: relative; flex: 1; min-height: 0; overflow: hidden; }
  #stage canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; touch-action: none; }

  #metrics { position: absolute; top: calc(12px + env(safe-area-inset-top)); left: 16px; right: 16px;
    display: flex; gap: 6px; pointer-events: none; }
  .metric { background: rgba(12, 17, 15, .78); border-radius: 10px; padding: 6px 10px; }
  .metric span { display: block; font-size: 10px; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
  .metric b { font-size: 17px; font-weight: 700; font-variant-numeric: tabular-nums; }
  .metric i { font-style: normal; font-size: 11px; color: var(--muted); margin-left: 2px; }
  #hint { position: absolute; right: 16px; top: calc(70px + env(safe-area-inset-top)); font-size: 12px; color: var(--muted);
    pointer-events: none; transition: opacity .6s ease; }

  #controls { position: absolute; left: 16px; right: 16px; bottom: 12px; display: flex; gap: 8px;
    justify-content: center; align-items: center; }
  #views { display: flex; padding: 3px; gap: 2px; background: rgba(12, 17, 15, .82); border-radius: 12px; }
  #views button { background: transparent; padding: 9px 12px; border-radius: 9px; font-size: 13px; font-weight: 600;
    color: var(--muted); transition: background-color .25s var(--ease), color .25s var(--ease); }
  #views button[aria-pressed="true"] { background: var(--accent); color: var(--ink); }
  #play { width: 44px; height: 44px; border-radius: 12px; background: var(--ink); color: var(--bg);
    display: grid; place-items: center; flex: none; transition: transform .2s var(--ease); }
  #play:active, #views button:active { transform: scale(.96); }
  #play svg { width: 20px; height: 20px; }

  #panel { flex: none; background: var(--panel); border-top: 1px solid var(--line);
    padding: 12px 16px calc(14px + env(safe-area-inset-bottom)); }
  .kicker { margin: 0 0 8px; font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
  .kicker b { color: var(--ink); letter-spacing: .02em; }
  #rows { list-style: none; margin: 0 0 8px; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }
  #rows li { background: var(--raise); border-radius: 10px; padding: 7px 8px 8px; min-width: 0; }
  #rows span { display: block; font-size: 10px; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); margin-bottom: 5px; }
  .chip { display: block; border-radius: 7px; padding: 6px 4px; text-align: center; font-size: 13px; font-weight: 700;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis; background: var(--line); color: var(--muted);
    transition: background-color .45s var(--ease), color .45s var(--ease), transform .45s var(--ease); }
  .chip.pending { transform: scale(.94); }
  .t-out { background: var(--out); color: var(--ink); }
  .t-not_out { background: var(--not-out); color: var(--ink); }
  .t-umpires_call { background: var(--call); color: var(--call-ink); }
  .t-none { background: var(--line); color: var(--ink); }
  #call { border-radius: 12px; padding: 10px 12px; text-align: center; font-size: 20px; font-weight: 800; letter-spacing: .06em;
    transition: background-color .5s var(--ease), color .5s var(--ease), transform .5s var(--ease); }
  #call.pending { transform: scale(.97); background: var(--raise); color: var(--muted); }
  #reason { margin: 8px 0 0; font-size: 13px; color: var(--muted); min-height: 18px; }

  /* wide screens put the decision beside the replay, the way a broadcast does */
  @media (min-aspect-ratio: 1/1) {
    #app { flex-direction: row; }
    #panel { width: 300px; border-top: 0; border-left: 1px solid var(--line); overflow-y: auto;
      padding: calc(20px + env(safe-area-inset-top)) calc(20px + env(safe-area-inset-right)) 20px 20px;
      display: flex; flex-direction: column; justify-content: center; }
    #rows { grid-template-columns: 1fr; gap: 8px; margin-bottom: 10px; }
    #rows li { display: flex; align-items: center; justify-content: space-between; padding: 8px 8px 8px 12px; }
    #rows span { margin: 0; font-size: 11px; }
    .chip { min-width: 128px; font-size: 14px; padding: 8px 10px; }
    #call { font-size: 24px; padding: 14px; }
  }
  @media (min-aspect-ratio: 1/1) and (max-height: 500px) {
    #panel { width: 250px; padding-top: calc(10px + env(safe-area-inset-top)); padding-bottom: 10px; }
    .kicker { margin-bottom: 6px; }
    #rows { gap: 5px; margin-bottom: 6px; }
    #rows li { padding: 5px 5px 5px 10px; }
    .chip { min-width: 108px; padding: 5px 8px; font-size: 13px; }
    #call { font-size: 18px; padding: 8px; }
    #reason { font-size: 12px; margin-top: 6px; }
    #hint { display: none; }
  }
  @media (max-width: 360px) { #views button { padding: 9px 9px; } }
</style>
</head>
<body>
<div id="app">
  <div id="stage">
    <div id="metrics">
      <div class="metric"><span>Speed</span><b id="m-speed">–</b><i>km/h</i></div>
      <div class="metric"><span>Swing</span><b id="m-swing">–</b><i>cm</i></div>
      <div class="metric"><span>Spin</span><b id="m-spin">–</b><i>deg</i></div>
    </div>
    <div id="hint">Drag to turn, pinch to zoom</div>
    <div id="controls">
      <button id="play" type="button" aria-label="Replay"></button>
      <div id="views" role="group" aria-label="Camera">
        <button type="button" data-view="umpire">Umpire</button>
        <button type="button" data-view="side">Side</button>
        <button type="button" data-view="top">Top</button>
        <button type="button" data-view="batter">Batter</button>
      </div>
    </div>
  </div>
  <aside id="panel" aria-live="polite">
    <p class="kicker"><b>Pocket DRS</b> &middot; Ball tracking</p>
    <ol id="rows"></ol>
    <div id="call" class="pending">&nbsp;</div>
    <p id="reason"></p>
  </aside>
</div>

<!-- no import map: iOS 15 Safari can't read one, so three.js loads by its path -->
<script type="module">
import * as THREE from "/static/three/build/three.module.min.js";

const P = __PAYLOAD__;
const L = P.pitch_length_m, PW = P.pitch_width_m;
const STUMP_H = 0.711, STUMP_HALF = 0.1143, STUMP_R = 0.0175, BALL_R = 0.036;
const POP = 1.22, RETURN_Y = 1.32, POP_HALF = 1.83;
const TONE = { out: 0xc9302d, not_out: 0x1c8742, umpires_call: 0xd0901e, none: 0x9aa59f };
const BALL = 0xd8322b, BALL_HEAD = 0xff7a6b, BG = 0x0c110f;
const $ = id => document.getElementById(id);
const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

// ---------------------------------------------------------------- renderer
const stage = $("stage");
let renderer;
try {
  renderer = new THREE.WebGLRenderer({ antialias: true });
} catch (e) {
  // webgl off or blocklisted would otherwise leave a blank page that looks like a broken link
  stage.innerHTML = '<p style="margin:30vh 24px 0;text-align:center;color:#9aa59f">This browser can\'t draw the 3D view. The verdict is not affected.</p>';
  throw e;
}
renderer.setPixelRatio(Math.min(2, window.devicePixelRatio || 1));
stage.prepend(renderer.domElement);
const scene = new THREE.Scene();
scene.background = new THREE.Color(BG);
scene.fog = new THREE.Fog(BG, 38, 75);
const camera = new THREE.PerspectiveCamera(40, 1, 0.1, 200);
camera.up.set(0, 0, 1);

scene.add(new THREE.HemisphereLight(0xe6efe9, 0x26362a, 1.25));
const sun = new THREE.DirectionalLight(0xfff6ea, 1.7);
sun.position.set(L * 0.7, -7, 12);
scene.add(sun);

// ---------------------------------------------------------------- ground
function canvasTexture(w, h, draw) {
  const c = document.createElement("canvas"); c.width = w; c.height = h;
  draw(c.getContext("2d"), w, h);
  const t = new THREE.CanvasTexture(c); t.colorSpace = THREE.SRGBColorSpace;
  return t;
}
{
  const grass = canvasTexture(64, 256, (g, w, h) => {
    for (let i = 0; i < 8; i++) { g.fillStyle = i % 2 ? "#2f6b3c" : "#357443"; g.fillRect(0, i * h / 8, w, h / 8); }
  });
  grass.wrapS = grass.wrapT = THREE.RepeatWrapping; grass.repeat.set(1, 12);
  const field = new THREE.Mesh(new THREE.CircleGeometry(75, 48), new THREE.MeshLambertMaterial({ map: grass }));
  field.position.set(L / 2, 0, -0.03); field.rotation.z = Math.PI / 2; scene.add(field);

  const soil = canvasTexture(128, 128, (g, w, h) => {
    g.fillStyle = "#b9ad7d"; g.fillRect(0, 0, w, h);
    for (let i = 0; i < 1400; i++) {
      g.fillStyle = Math.random() < .5 ? "rgba(90,80,45,.10)" : "rgba(255,250,225,.10)";
      g.fillRect(Math.random() * w, Math.random() * h, 1 + Math.random() * 2, 1 + Math.random() * 2);
    }
  });
  soil.wrapS = soil.wrapT = THREE.RepeatWrapping; soil.repeat.set(12, 2);
  const strip = new THREE.Mesh(new THREE.PlaneGeometry(L + 4.4, PW), new THREE.MeshLambertMaterial({ map: soil }));
  strip.position.set(L / 2, 0, 0); scene.add(strip);

  // Law 7 markings: bowling crease through the stumps, popping crease 1.22 m in front, return creases 1.32 m out
  const chalk = new THREE.MeshBasicMaterial({ color: 0xf1f4ef });
  const mark = (x0, y0, x1, y1) => {
    const m = new THREE.Mesh(new THREE.PlaneGeometry(Math.abs(x1 - x0) || 0.05, Math.abs(y1 - y0) || 0.05), chalk);
    m.position.set((x0 + x1) / 2, (y0 + y1) / 2, 0.012); scene.add(m);
  };
  for (const [x, dir] of [[0, 1], [L, -1]]) {
    mark(x, -RETURN_Y, x, RETURN_Y);
    mark(x + dir * POP, -POP_HALF, x + dir * POP, POP_HALF);
    for (const y of [-RETURN_Y, RETURN_Y]) mark(x + dir * POP, y, x - dir * POP, y);
  }
  // the stump-to-stump channel the in-line checks are about
  const lane = new THREE.Mesh(new THREE.PlaneGeometry(L, STUMP_HALF * 2),
    new THREE.MeshBasicMaterial({ color: 0xf7f9f7, transparent: true, opacity: 0.09, depthWrite: false }));
  lane.position.set(L / 2, 0, 0.008); scene.add(lane);
}

// ---------------------------------------------------------------- stumps and bails
function wicket(x) {
  const g = new THREE.Group();
  const wood = new THREE.MeshStandardMaterial({ color: 0xe9e4d6, roughness: 0.55 });
  const stump = new THREE.CylinderGeometry(STUMP_R, STUMP_R, STUMP_H, 12);
  stump.rotateX(Math.PI / 2);
  for (const y of [-(STUMP_HALF - STUMP_R), 0, STUMP_HALF - STUMP_R]) {
    const m = new THREE.Mesh(stump, wood); m.position.set(x, y, STUMP_H / 2); g.add(m);
  }
  const bail = new THREE.CylinderGeometry(0.008, 0.008, STUMP_HALF - 0.004, 8);
  for (const y of [-STUMP_HALF / 2, STUMP_HALF / 2]) {
    const b = new THREE.Mesh(bail, wood); b.position.set(x, y, STUMP_H + 0.008); g.add(b);
  }
  scene.add(g);
}
wicket(0); wicket(L);

// ---------------------------------------------------------------- the ball's path
const V = (r) => new THREE.Vector3(r[1], r[2], Math.max(BALL_R, r[3]));
// rows are [t_ms, x, y, z]; each run is drawn through a spline, keeping its sample times
function densify(rows) {
  if (rows.length < 2) return rows.map(r => ({ t: r[0], p: V(r) }));
  const curve = new THREE.CatmullRomCurve3(rows.map(V), false, "centripetal");
  const n = rows.length - 1, m = Math.max(12, n * 8), out = [];
  for (let j = 0; j <= m; j++) {
    const k = j / m * n, i = Math.min(n - 1, Math.floor(k));
    out.push({ t: rows[i][0] + (rows[i + 1][0] - rows[i][0]) * (k - i), p: curve.getPoint(j / m) });
  }
  return out;
}
const tracked = P.tracked.slice().sort((a, b) => a[0] - b[0]);
let flight = [];
const b = P.bounce;
if (b && tracked.length >= 2 && b[0] > tracked[0][0] && b[0] < tracked[tracked.length - 1][0]) {
  // split at the bounce so the pitch reads as a sharp V, not a curve smoothed through the ground
  const pre = tracked.filter(r => r[0] < b[0]).concat([b]), post = [b].concat(tracked.filter(r => r[0] > b[0]));
  flight = densify(pre).concat(densify(post).slice(1));
} else flight = densify(tracked);
// the first predicted row repeats the last tracked one
const ahead = P.predicted.length >= 2 ? densify(P.predicted) : [];

function withLength(pts) {
  let s = 0;
  pts.forEach((q, i) => { if (i) s += q.p.distanceTo(pts[i - 1].p); q.s = s; });
  return s;
}
const flightLen = withLength(flight), aheadLen = withLength(ahead);

// a straight-segment curve, so the tube passes through the bounce corner instead of rounding it
class Polyline extends THREE.Curve {
  constructor(pts, len) { super(); this.pts = pts; this.len = len || 1; }
  getPoint(u, out = new THREE.Vector3()) {
    const s = u * this.len, pts = this.pts;
    let i = 1; while (i < pts.length - 1 && pts[i].s < s) i++;
    const a = pts[i - 1], z = pts[i], f = (s - a.s) / ((z.s - a.s) || 1);
    return out.copy(a.p).lerp(z.p, Math.min(1, Math.max(0, f)));
  }
}
const RADIAL = 10;
function tube(pts, len, opacity) {
  if (pts.length < 2 || len <= 0) return null;
  const segs = Math.min(200, Math.max(24, Math.round(len * 10)));
  const geo = new THREE.TubeGeometry(new Polyline(pts, len), segs, BALL_R * 0.92, RADIAL, false);
  const mat = new THREE.MeshStandardMaterial({ color: BALL, roughness: 0.4, emissive: BALL, emissiveIntensity: 0.18,
    transparent: opacity < 1, opacity, depthWrite: opacity >= 1 });
  const mesh = new THREE.Mesh(geo, mat); mesh.userData.segs = segs; scene.add(mesh);
  return mesh;
}
const flightTube = tube(flight, flightLen, 1), aheadTube = tube(ahead, aheadLen, 0.42);
// tube ends are open; a sphere closes the one at the release point
const cap = new THREE.Mesh(new THREE.SphereGeometry(BALL_R * 0.92, 12, 8), flightTube ? flightTube.material : undefined);
if (flight.length) { cap.position.copy(flight[0].p); scene.add(cap); }
function grow(mesh, frac) {
  if (mesh) mesh.geometry.setDrawRange(0, Math.round(Math.min(1, Math.max(0, frac)) * mesh.userData.segs) * RADIAL * 6);
}

const ball = new THREE.Mesh(new THREE.SphereGeometry(BALL_R * 1.12, 20, 14),
  new THREE.MeshStandardMaterial({ color: BALL_HEAD, roughness: 0.3, emissive: BALL_HEAD, emissiveIntensity: 0.45 }));
scene.add(ball);
const shadow = new THREE.Mesh(new THREE.PlaneGeometry(0.34, 0.34), new THREE.MeshBasicMaterial({
  transparent: true, depthWrite: false, color: 0x000000,
  alphaMap: canvasTexture(64, 64, (g) => {
    const r = g.createRadialGradient(32, 32, 0, 32, 32, 32);
    r.addColorStop(0, "#fff"); r.addColorStop(1, "#000"); g.fillStyle = r; g.fillRect(0, 0, 64, 64);
  }),
}));
scene.add(shadow);

// ---------------------------------------------------------------- markers, coloured by their DRS row
const verdict = P.verdict;
const toneOf = i => verdict ? TONE[verdict.rows[i].tone] : 0x2ea86a;
function ring(r0, r1, color, opacity) {
  return new THREE.Mesh(new THREE.RingGeometry(r0, r1, 40),
    new THREE.MeshBasicMaterial({ color, transparent: true, opacity, side: THREE.DoubleSide, depthWrite: false }));
}
const markers = [];
if (b) {
  const g = new THREE.Group();
  g.add(new THREE.Mesh(new THREE.CircleGeometry(0.11, 32),
    new THREE.MeshBasicMaterial({ color: toneOf(0), transparent: true, opacity: 0.95, depthWrite: false })));
  g.add(ring(0.15, 0.19, toneOf(0), 0.9));
  g.position.set(b[1], b[2], 0.016); scene.add(g);
  markers.push({ obj: g, t: b[0] });
}
const imp = P.impact;
if (imp) {
  const g = new THREE.Group();
  g.add(ring(0.08, 0.11, toneOf(1), 1));
  const pulse = ring(0.08, 0.1, toneOf(1), 1); g.add(pulse);
  g.rotation.y = Math.PI / 2;           // face down the pitch, like the pad it hit
  g.position.copy(V(imp)); scene.add(g);
  markers.push({ obj: g, t: imp[0], pulse });
}
let zone = null;
if (ahead.length) {
  // the face of the stumps lights up in the wickets colour when the path arrives
  zone = new THREE.Mesh(new THREE.PlaneGeometry(STUMP_H, STUMP_HALF * 2).rotateY(Math.PI / 2),
    new THREE.MeshBasicMaterial({ color: toneOf(2), transparent: true, opacity: 0.3, side: THREE.DoubleSide, depthWrite: false }));
  zone.position.set(-0.01, 0, STUMP_H / 2); scene.add(zone);
  markers.push({ obj: zone, t: ahead[ahead.length - 1].t });
}

// ---------------------------------------------------------------- HUD
const fmt = (v, d) => v == null ? "–" : Number(v).toFixed(d);   // null is "not measured", not zero
$("m-speed").textContent = fmt(P.speed_kmh, 0);
$("m-swing").textContent = fmt(P.swing_cm, 1);
$("m-spin").textContent = fmt(P.spin_deg, 0);
const CALL_TEXT = { out: "OUT", not_out: "NOT OUT", umpires_call: "UMPIRE'S CALL" };
const rowsEl = $("rows"), chips = [];
for (const r of verdict ? verdict.rows : []) {
  const li = document.createElement("li"), label = document.createElement("span"), chip = document.createElement("b");
  label.textContent = r.label; chip.className = "chip pending"; chip.textContent = " ";
  li.append(label, chip); rowsEl.append(li); chips.push({ chip, row: r });
}
if (!verdict) rowsEl.style.display = "none";
function reveal(i) {
  const c = chips[i]; if (!c || !c.chip.classList.contains("pending")) return;
  c.chip.className = "chip t-" + c.row.tone; c.chip.textContent = c.row.value;
}
function revealCall() {
  const el = $("call"); if (!el.classList.contains("pending")) return;
  el.className = verdict ? "t-" + verdict.decision : "t-none";
  el.textContent = verdict ? CALL_TEXT[verdict.decision] : "NO CALL";
  $("reason").textContent = verdict ? verdict.reason : "There was not enough to make a call. The tracked path is shown.";
}

// ---------------------------------------------------------------- replay clock
const path = flight.concat(ahead.slice(1));
const tStart = path.length ? path[0].t : 0, tEnd = path.length ? path[path.length - 1].t : 0;
const tFlightEnd = flight.length ? flight[flight.length - 1].t : tStart;
// real deliveries last under a second, so the replay runs in slow motion
const DUR = Math.min(3600, Math.max(1800, (tEnd - tStart) * 3)), LEAD = 350;
let playStart = null, pausedAt = null, finished = false;
const playBtn = $("play");
const ICON = {
  play: '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.5-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5z"/></svg>',
  pause: '<svg viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg>',
  replay: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12a8 8 0 1 0 2.4-5.7"/><path d="M4 4v4.5h4.5"/></svg>',
};
function setIcon(k, label) { playBtn.innerHTML = ICON[k]; playBtn.setAttribute("aria-label", label); }
function play(now) { playStart = now; pausedAt = null; finished = false; setIcon("pause", "Pause"); wake(); }
playBtn.addEventListener("click", () => {
  const now = performance.now();
  if (finished || playStart === null) play(now);
  else if (pausedAt !== null) { playStart += now - pausedAt; pausedAt = null; setIcon("pause", "Pause"); wake(); }
  else { pausedAt = now; setIcon("play", "Play"); }
});

const _p = new THREE.Vector3();
function sampleAt(t, pts) {
  let i = 1; while (i < pts.length - 1 && pts[i].t < t) i++;
  const a = pts[i - 1], z = pts[i], f = Math.min(1, Math.max(0, (t - a.t) / ((z.t - a.t) || 1)));
  _p.copy(a.p).lerp(z.p, f);
  return a.s + (z.s - a.s) * f;
}
function placeBall(t) {
  if (!path.length) { ball.visible = shadow.visible = false; return; }
  const inFlight = t <= tFlightEnd || !ahead.length;
  const s = sampleAt(t, inFlight ? flight : ahead);
  grow(flightTube, inFlight ? s / (flightLen || 1) : 1);
  grow(aheadTube, inFlight ? 0 : s / (aheadLen || 1));
  ball.position.copy(_p);
  shadow.position.set(_p.x, _p.y, 0.014);
  shadow.material.opacity = 0.45 * Math.max(0.15, 1 - _p.z / 3);
  for (const m of markers) {
    const k = Math.min(1, Math.max(0, (t - m.t) / ((tEnd - tStart) * 0.25 || 1)));
    m.obj.visible = t >= m.t;
    m.obj.scale.setScalar(m.obj === zone ? 1 : 0.4 + 0.6 * (1 - Math.pow(1 - k, 3)));
    if (m.pulse) { m.pulse.scale.setScalar(1 + 1.6 * k); m.pulse.material.opacity = 1 - k; }
  }
  if (verdict) {
    if (b && t >= b[0]) reveal(0); else if (!b && t >= tStart) reveal(0);
    if (imp && t >= imp[0]) reveal(1);
  }
}
function step(now) {
  if (playStart === null) { placeBall(tStart); return false; }
  const el = (pausedAt ?? now) - playStart - LEAD;
  const t = tStart + Math.max(0, Math.min(1, el / DUR)) * (tEnd - tStart);
  placeBall(t);
  if (el >= DUR) {
    reveal(0); reveal(1); reveal(2);
    if (el >= DUR + 450) { revealCall(); if (!finished) { finished = true; setIcon("replay", "Replay"); } }
  }
  return !finished && pausedAt === null;
}

// ---------------------------------------------------------------- camera: presets and touch orbit
const cur = { az: 0, el: 0.3, r: 25, tg: new THREE.Vector3(L / 2, 0, 0.5) };
const goal = { az: 0, el: 0.3, r: 25, tg: new THREE.Vector3(L / 2, 0, 0.5) };
let rate = 4.5, view = "umpire", W = 1, H = 1, insetTop = 0, insetBot = 0;
const pathPts = path.map(q => q.p);
const wicketPts = x => [new THREE.Vector3(x, -STUMP_HALF, 0), new THREE.Vector3(x, STUMP_HALF, STUMP_H)];
function viewSpec(name) {
  const tall = H > W;
  switch (name) {
    // a phone held upright is too narrow for square-on, so it looks from wide of the striker instead
    case "side": return { az: tall ? -2.2 : -Math.PI / 2, el: tall ? 0.3 : 0.16, tg: [L / 2, 0, 0.4],
      keep: pathPts.concat(wicketPts(0), wicketPts(L)) };
    case "top": return { az: tall ? Math.PI : -Math.PI / 2, el: 1.55, tg: [L / 2, 0, 0],
      keep: [[-POP, -POP_HALF], [L + POP, POP_HALF], [-POP, POP_HALF], [L + POP, -POP_HALF]].map(([x, y]) => new THREE.Vector3(x, y, 0)) };
    case "batter": return { az: Math.PI, el: tall ? 0.38 : 0.2, tg: [L * 0.55, 0, 0.6], keep: pathPts.concat(wicketPts(L)) };
    default: return { az: 0, el: tall ? 0.45 : 0.3, tg: [Math.min(L * 0.3, imp ? imp[1] + 2 : 6), 0, 0.5],
      // the release point is right by this camera; framing it too would shrink the batter's end to nothing
      keep: pathPts.filter(p => p.x < L * 0.55).concat(wicketPts(0)) };
  }
}
const fitCam = new THREE.PerspectiveCamera(); fitCam.up.set(0, 0, 1);
function place(cam, s) {
  const c = Math.cos(s.el);
  cam.position.set(s.tg.x + s.r * c * Math.cos(s.az), s.tg.y + s.r * c * Math.sin(s.az), s.tg.z + s.r * Math.sin(s.el));
  cam.lookAt(s.tg); cam.updateMatrixWorld();
}
// back off until every point that matters sits clear of the overlays
function fit(spec) {
  fitCam.fov = camera.fov; fitCam.aspect = camera.aspect;
  fitCam.setViewOffset(W, H, 0, (insetBot - insetTop) / 2, W, H); fitCam.updateProjectionMatrix();
  const top = 1 - 2 * insetTop / H - 0.04, bot = -1 + 2 * insetBot / H + 0.04, v = new THREE.Vector3();
  const s = { az: spec.az, el: spec.el, tg: new THREE.Vector3(...spec.tg), r: 2 };
  for (; s.r < 120; s.r *= 1.04) {
    place(fitCam, s);
    if (spec.keep.every(p => { v.copy(p).project(fitCam); return v.z < 1 && Math.abs(v.x) < 0.92 && v.y < top && v.y > bot; })) break;
  }
  return s;
}
function setView(name, snap) {
  view = name;
  const s = fit(viewSpec(name));
  // turn the short way round
  goal.az = s.az + Math.round((cur.az - s.az) / (2 * Math.PI)) * 2 * Math.PI;
  goal.el = s.el; goal.r = s.r; goal.tg.copy(s.tg); rate = 4.2;
  if (snap || reduced) { cur.az = goal.az; cur.el = goal.el; cur.r = goal.r; cur.tg.copy(goal.tg); }
  for (const btn of document.querySelectorAll("#views button")) btn.setAttribute("aria-pressed", String(btn.dataset.view === name));
  wake();
}
$("views").addEventListener("click", e => { const v = e.target.closest("button"); if (v) setView(v.dataset.view); });

const canvas = renderer.domElement, ptrs = new Map();
const spread = () => { const [a, z] = [...ptrs.values()]; return Math.hypot(a.x - z.x, a.y - z.y) || 1; };
function userMoved() {
  rate = 16; view = null; $("hint").style.opacity = "0";
  for (const btn of document.querySelectorAll("#views button")) btn.setAttribute("aria-pressed", "false");
  wake();
}
canvas.addEventListener("pointerdown", e => { canvas.setPointerCapture(e.pointerId); ptrs.set(e.pointerId, { x: e.clientX, y: e.clientY }); });
canvas.addEventListener("pointermove", e => {
  const prev = ptrs.get(e.pointerId); if (!prev) return;
  if (ptrs.size === 1) {
    goal.az -= (e.clientX - prev.x) * 0.008;
    goal.el = Math.min(1.55, Math.max(0.04, goal.el + (e.clientY - prev.y) * 0.006));
    ptrs.set(e.pointerId, { x: e.clientX, y: e.clientY });
  } else if (ptrs.size === 2) {
    const before = spread(); ptrs.set(e.pointerId, { x: e.clientX, y: e.clientY });
    goal.r = Math.min(70, Math.max(1.5, goal.r * before / spread()));
  }
  userMoved();
});
const lift = e => ptrs.delete(e.pointerId);
canvas.addEventListener("pointerup", lift); canvas.addEventListener("pointercancel", lift);
canvas.addEventListener("wheel", e => { e.preventDefault(); goal.r = Math.min(70, Math.max(1.5, goal.r * Math.exp(e.deltaY * 0.0012))); userMoved(); }, { passive: false });

function easeCamera(dt) {
  // exponential approach: an ease-out that stays smooth when a new goal arrives mid-move
  const k = reduced ? 1 : 1 - Math.exp(-rate * dt);
  cur.az += (goal.az - cur.az) * k; cur.el += (goal.el - cur.el) * k; cur.r += (goal.r - cur.r) * k;
  cur.tg.lerp(goal.tg, k);
  place(camera, cur);
  return Math.abs(goal.az - cur.az) + Math.abs(goal.el - cur.el) > 1e-4 || Math.abs(goal.r - cur.r) > 1e-3 || cur.tg.distanceTo(goal.tg) > 1e-3;
}

// ---------------------------------------------------------------- size and loop
function resize() {
  const w = stage.clientWidth, h = stage.clientHeight;
  if (!w || !h || (w === W && h === H)) return;
  const flipped = (w > h) !== (W > H);
  W = w; H = h;
  renderer.setSize(W, H, false);
  camera.fov = H > W ? 46 : 36; camera.aspect = W / H;
  const sr = stage.getBoundingClientRect();
  insetTop = $("metrics").getBoundingClientRect().bottom - sr.top + 8;
  insetBot = sr.bottom - $("controls").getBoundingClientRect().top + 8;
  camera.setViewOffset(W, H, 0, (insetBot - insetTop) / 2, W, H);
  camera.updateProjectionMatrix();
  if (view) setView(view, flipped || playStart === null);
  wake();
}
let raf = 0, last = 0;
function frame(now) {
  raf = 0;
  const dt = Math.min(0.05, (now - (last || now)) / 1000); last = now;
  const moving = easeCamera(dt);
  const playing = step(now);
  renderer.render(scene, camera);
  // nothing moving: stop drawing so an idle page doesn't drain the battery
  if (moving || playing) raf = requestAnimationFrame(frame); else last = 0;
}
function wake() { if (!raf) raf = requestAnimationFrame(frame); }

new ResizeObserver(resize).observe(stage);
resize();
setView("umpire", true);
setIcon("play", "Play");
if (reduced) { playStart = performance.now() - DUR - LEAD - 500; }
setTimeout(() => { if (playStart === null) play(performance.now()); else wake(); }, reduced ? 0 : 500);
setTimeout(() => { $("hint").style.opacity = "0"; }, 5000);
</script>
</body>
</html>
